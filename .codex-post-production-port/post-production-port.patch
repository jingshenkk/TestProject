+        viewBox=0 0 24 24
+        fill=none
+        stroke=currentColor
+        strokeWidth={1.8}
+        strokeLinecap=round
+        strokeLinejoin=round
+        className={`${baseClass} ${className}`.trim()}
+      >
+        {d.map((p, i) => (
